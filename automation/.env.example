# CMO War Room — D-minus 수집기 환경변수
# 실제 값은 커밋 금지. 셸 export 또는 CI 시크릿(GitHub Actions secrets 등)으로 주입.

# --- KOBIS (사전예매/박스오피스) ---
# 발급: https://www.kobis.or.kr/kobisopenapi (오픈API 키)
KOBIS_KEY=
# 기본값은 일별 박스오피스 엔드포인트. 사전예매(예매율) 전용 소스를 쓰면 여기서 교체.
# KOBIS_BASE=https://www.kobis.or.kr/kobisopenapi/webservice/rest/boxoffice/searchDailyBoxOfficeList.json

# --- 버즈(WOM) ---
# {title} 과 {date} 플레이스홀더가 치환됨. 실제 버즈 소스 URL 형식에 맞춰 설정.
# 예) https://buzz.example.com/api/mentions?q={title}&date={date}
BUZZ_URL=
# 버즈 소스가 인증을 요구하면(Bearer 토큰) 설정. 없으면 비워둠.
BUZZ_KEY=

# --- 텔레그램 경보 ---
# 봇 토큰(@BotFather), 대상 채팅 ID. 미설정 시 알림은 콘솔로만 출력.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 튜닝(선택) ---
RETRIES=6            # 소스별 재시도 횟수
TIMEOUT_MS=15000     # 요청당 타임아웃(ms)
TRACK_WINDOW_DAYS=14 # 개봉 며칠 전부터 추적/백필 대상으로 볼지
